  "sources": [
    {
      "hero": "Anti-Mage",
      "url": "https://web.archive.org/web/20230215191509id_/https://dota2.fandom.com/wiki/Anti-Mage",
      "status": 200,
      "accessedOn": "2026-10-30",
      "sha256": "005df87f109712c0df4063990f53434f360962f8db43065ac73987c570176684",
      "observation": "Mana Break is noncritical physical conditional attack damage,counts for ordinary lifesteal/cleave/oneflatblock,ignores percentage attack bonuses and burns half with illusions. Burn precedes attack and empty-pool slow follows. Native BlinkFragment is antimage_mana_overload:1level,3charges,25restore,45mana,0.2+0.84,75/200percent,7seconds,default750range without Blink. Native3ManaVoid stuns only the primary before shared damage.",
      "versionContext": "Actual HTTP2002023-02-15Wayback hero page read during C10intake. AA explicit values override native balance;modern post7.33changes are not imported."
    },
    {
      "hero": "Lion",
      "url": "https://web.archive.org/web/20230215191945id_/https://dota2.fandom.com/wiki/Lion",
      "status": 200,
      "accessedOn": "2026-10-30",
      "sha256": "f5420f38384ccda6bd22528def079c59e88b85ccb87791e3cf9b2b0340ace24c",
      "observation": "Mana Drain0.3+0/850 starts at0.1and ticks50times over5seconds;ordinary illusions die without mana transfer,strong illusions are drained. It supplies TrueSight. Primary immunity/untargetability ends the channel. Secondary invisibility pauses mana/damage despite the retained link and slow;secondary immunity retains drain/slow without magical damage. Native talent coefficient150percent is distinguished from AA unspecified damage. Native link/TrueSight modifier is Death-only and is not removed by basic or strong dispel.",
      "versionContext": "Actual HTTP2002023-02-15Wayback hero page read during C10intake. AA explicit values override native balance;modern post7.33changes are not imported."
    },
    {
      "hero": "Medusa",
      "url": "https://web.archive.org/web/20230215191810id_/https://dota2.fandom.com/wiki/Medusa",
      "status": 200,
      "accessedOn": "2026-10-30",
      "sha256": "664a9c2419fcf6444c81d35788fd1a4f18396196935d27968d058982bc444f5a",
      "observation": "Pre7.33 ManaShield is toggle protection before incoming reductions/block/barriers,excluding HPLOSS. MysticSnake uses maximum-mana restoration without burning enemy mana,excludes illusion mana returns,increases speed multiplicatively15percent and damage linearly35percent,does not count invalid victims,returns on impact SpellBlock and applies damage then slow then stone. Its stone uses the nonstacking StoneGaze modifier. Native shield toggle is undispellable.",
      "versionContext": "Actual HTTP2002023-02-15Wayback hero page read during C10intake. AA explicit values override native balance;modern post7.33changes are not imported."
    },
    {
      "hero": "Pudge",
      "url": "https://web.archive.org/web/20230215191542id_/https://dota2.fandom.com/wiki/Pudge",
      "status": 200,
      "accessedOn": "2026-10-30",
      "sha256": "ff04d65ddbb348f93bd45a55add2fdb17beab9220426ac5b43ef5e476eb398e9",
      "observation": "MeatHook0.3+0.59,1450speed/100collision radius and full return hold ignore status resistance;spell-immune victims are pulled and damaged without disable. AA specifically restricts collision to enemy heroes,overriding native ally rescue/creep execution. Return origin is separately corroborated by the dated2013patch.",
      "versionContext": "Actual HTTP2002023-02-15Wayback hero page read during C10intake. AA explicit values override native balance;modern post7.33changes are not imported."
    },
    {
      "hero": "Naga_Siren",
      "url": "https://web.archive.org/web/20230215191633id_/https://dota2.fandom.com/wiki/Naga_Siren",
      "status": 200,
      "accessedOn": "2026-10-30",
      "sha256": "ad0041533f955ee9d822567196cb136c2b6660d118012e23c0c264c7344a313b",
      "observation": "MirrorImage0.4+0 then0.5split applies basic dispel/disjoint and hidden/invulnerable/spellimmune states,then cardinal formation with randomized caster placement;recasts replace old images. RipTide applies armor before one magical wave per unique victim and before the triggering attack;actual triggering body owns damage. The summary says independent counters while detail and AA wording support shared counting,so the conflict remains explicit.",
      "versionContext": "Actual HTTP2002023-02-15Wayback hero page read during C10intake. AA explicit values override native balance;modern post7.33changes are not imported."
    }
  ],
  "muerta": {
    "id": "muerta2023",
    "url": "https://web.archive.org/web/20230315233726id_/https://dota2.fandom.com/wiki/Muerta",
