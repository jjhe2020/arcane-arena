  "sectionObservations": [
    {
      "id": "custom_rubick_spell_steal",
      "observations": [
        {
          "sourceId": "rubick-2023",
          "paraphrase": "Return projectile1200 acquires/replaces on arrival; death loses slots, Gtwo FIFO. Native copied point cap.15 and target/upgrades restrictions are separate from AA point tiers. Enemy debuffs gain10/20/30percent duration; friendly buffs do not."
        },
        {
          "sourceId": "rubick-interactions-2022",
          "paraphrase": "Copied spell cooldowns and charge state survive replacement/reacquisition. Lost abilities are not reset by absent-slot cooldown resets. Already released effects and transform/summon cleanup have named per-ability exceptions; amplification persistence does not prove every contact hook."
        }
      ]
    },
    {
      "id": "terrorblade_sunder",
      "observations": [
        {
          "sourceId": "terrorblade-2023",
          "paraphrase": "Sunder uses nonlethal SetHealth fractions and a minimum for each recipient, including both-low cases. Ally/enemy heroes and illusions are legal; Soulbind rotates caster, primary and secondary fractions. Native.35+.83 and475range are dated candidates."
        },
        {
          "sourceId": "willow-2023",
          "paraphrase": "Realm applies after.3, consumes at launch and creates attack-specific logic limited by hit, three seconds or death. Charge freezes at launch; separate magical damage precedes attack damage. Range bonus applies only to ranged bodies; Scepter repeats without leaving."
        }
      ]
    },
    {
      "id": "dark_seer_vacuum",
      "observations": [
        {
          "sourceId": "seer-2023",
          "paraphrase": "Vacuum freezes its point and pulls over terrain for a full rank duration; invulnerable bodies except item cyclone are affected. Removal commits damage. Normal Punch uses minimums, recent movement and per-teleport600cap; stun precedes spell damage and knockback."
        },
        {
          "sourceId": "morphling-2023",
          "paraphrase": "Existing C13 actual Waveform supplies its invulnerable released controller and own onEnd cleanup. Vacuum pairing tests the specific documented invulnerable-target qualification; unrelated controller priorities are not generalized."
        }
      ]
    },
    {
      "id": "custom_hoodwink_sharpshooter",
      "observations": [
        {
          "sourceId": "hoodwink-2023",
          "paraphrase": "Sharpshooter aims without ordinary channel interruption, with60degree/s turning,20percent initial power, five-second auto release and disable survival. Bolt eligibility and debuff-before-damage are explicit. Boomerang unit targets, disjoint last-location return and incoming spell-only additive amplification are documented."
        },
        {
          "sourceId": "willow-2023",
          "paraphrase": "Realm applies after.3, consumes at launch and creates attack-specific logic limited by hit, three seconds or death. Charge freezes at launch; separate magical damage precedes attack damage. Range bonus applies only to ranged bodies; Scepter repeats without leaving."
        }
      ]
    },
