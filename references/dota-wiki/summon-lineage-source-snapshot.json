      ],
      "superUpgrade": "Super: Blinks Shapeshift unit to enemy backline (1500 range), fearing enemies in 400 AOE for 1.5 seconds.",
      "gabenUpgrade": "Gaben: Applies Wolf Bite to the closest ally in 600 radius."
